{
  "name": "@gears-web/telemetry",
  "version": "0.1.0",
  "description": "Browser telemetry SDK: session tracking, device and navigation context, DOM autocapture, and a plugin system.",
  "license": "Apache-2.0",
  "author": "Constructor Fabric Foundation",
  "homepage": "https://github.com/constructorfabric/gears-web/tree/main/gears/telemetry/telemetry#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/constructorfabric/gears-web.git",
    "directory": "gears/telemetry/telemetry"
  },
  "bugs": {
    "url": "https://github.com/constructorfabric/gears-web/issues"
  },
  "keywords": [
    "telemetry",
    "analytics",
    "events",
    "autocapture",
    "browser",
    "sdk",
    "constructorfabric"
  ],
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICE",
    "README.md"
  ],
  "main": "./dist/client.js",
  "types": "./dist/client.d.ts",
  "exports": {
    ".": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "scripts": {
    "build": "vite build",
    "lint": "pnpm run lint:code && pnpm run lint:ts",
    "lint:code": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:ts": "tsc -p tsconfig.json && tsc -p tsconfig.node.json",
    "prepublishOnly": "pnpm run build",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "bowser": "2.11.0"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@stylistic/eslint-plugin": "5.7.1",
    "@types/node": "22.15.29",
    "eslint": "9.39.4",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.5",
    "eslint-plugin-unused-imports": "4.3.0",
    "globals": "17.1.0",
    "happy-dom": "20.10.6",
    "prettier": "3.8.1",
    "rollup-plugin-node-externals": "8.1.2",
    "typescript": "6.0.3",
    "typescript-eslint": "8.59.0",
    "vite": "8.0.16",
    "vite-plugin-dts": "4.5.4",
    "vitest": "4.1.5"
  },
  "sideEffects": false
}
