{
  "name": "@gears/ui-kit",
  "version": "0.1.0",
  "description": "Standard React component base for Constructor Fabric front-end templates: curated shadcn/ui-derived components on Base UI + Tailwind + CVA.",
  "license": "Apache-2.0",
  "author": "Constructor Fabric Foundation",
  "homepage": "https://github.com/constructorfabric/gears-web/tree/main/gears/uikit#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/constructorfabric/gears-web.git",
    "directory": "gears/uikit/ui-kit"
  },
  "bugs": {
    "url": "https://github.com/constructorfabric/gears-web/issues"
  },
  "keywords": [
    "ui",
    "components",
    "react",
    "tailwind",
    "base-ui",
    "constructorfabric"
  ],
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./theme.css": "./dist/theme.css"
  },
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "build": "vite build && cp src/styles/theme.css dist/theme.css",
    "lint": "tsc -p tsconfig.json"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "rollup-plugin-node-externals": "8.1.2",
    "typescript": "6.0.3",
    "vite": "8.0.16",
    "vite-plugin-dts": "4.5.4"
  }
}
